# Pick one provider: openai | groq | gemini  (all are called via OpenAI-compatible endpoints)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: override the default model for the provider (check the provider's current model list)
LLM_MODEL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop
